# NearCut — exemplu de configurare locală.
# Copiază în .env.local. Nu comite niciodată valori reale/secrete.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Doar server-side: necesar pentru webhook-ul WhatsApp, guest booking și ICS.
SUPABASE_SERVICE_ROLE_KEY=

# URL public al aplicației (ex. https://app.nearcut.ro)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Meta WhatsApp Business Platform / Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
# Setează explicit versiunea Graph API activă în contul Meta.
WHATSAPP_GRAPH_API_VERSION=

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# 32 bytes encoded base64, folosit ulterior pentru criptarea token-urilor OAuth.
ENCRYPTION_KEY=
